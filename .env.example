# ============================================================
#  น้องฝนเฝ้าบ้าน — ไฟล์ตั้งค่า (คัดลอกเป็น .env แล้วแก้)
#  ค่าในไฟล์นี้เป็นความลับ ห้ามส่งให้ใครหรืออัปขึ้น GitHub
#  ค่าที่ไม่ใช่ความลับ (รอบการตรวจ เกณฑ์ โมเดล ฯลฯ) ปรับในหน้า "ตั้งค่า" บนเว็บได้เลย
# ============================================================

# ---------- 1) รหัสผ่านหน้าเว็บ (จำเป็น) ----------
DASHBOARD_PASSWORD=

# ---------- 2) กล้อง (อย่างน้อย 1 ตัว สูงสุด 12 ตัว) ----------
# RTSP      : rtsp://ชื่อผู้ใช้:รหัสผ่าน@IPกล้อง:554/stream1
# ภาพนิ่ง    : http://ชื่อผู้ใช้:รหัสผ่าน@IPกล้อง/snapshot.jpg
# go2rtc    : http://host.docker.internal:1984/api/frame.jpeg?src=ชื่อกล้อง
# วิธีหาลิงก์ของแต่ละยี่ห้อ ดู docs/cameras.md
CAMERA_1_NAME=หน้าบ้าน
CAMERA_1_URL=
CAMERA_2_NAME=โรงรถ
CAMERA_2_URL=

# ---------- 3) สมองของน้องฝน — เลือก 1 แบบ (npm run setup เลือกให้ได้) ----------
# แบบ ก: GPT ผ่าน OpenAI API (จ่ายตามใช้ ถูกสุด แนะนำ) — สร้างคีย์ที่ https://platform.openai.com/api-keys
# gpt-6-luna ราว $0.0012 ต่อการตรวจ 3 กล้อง ≈ 170 บาท/เดือน ถ้าตรวจทุก 10 นาที (เปลี่ยนรุ่นได้ในหน้าตั้งค่า)
AI_ENGINE=openai
OPENAI_API_KEY=
AI_MODEL=gpt-6-luna

# แบบ ข: Claude API (จ่ายตามใช้) — สร้างคีย์ที่ https://console.anthropic.com
# AI_ENGINE=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5          (claude-opus-5-5 แม่นสุด · claude-haiku-4-5 ประหยัด)

# แบบ ค: ใช้แพ็กเกจ Claude Pro/Max ที่มีอยู่แล้ว — รันคำสั่ง  claude setup-token  ในเครื่องตัวเอง แล้ววางโทเคนที่ได้
# AI_ENGINE=claude-code
# CLAUDE_CODE_OAUTH_TOKEN=

# ยังไม่มีคีย์? เปิดโหมดสาธิต (กล้องภาพวาด + AI จำลอง ไม่เสียเงิน)
# DEMO=1

# ---------- 4) Telegram (แนะนำ) ----------
# สร้างบอทกับ @BotFather แล้ววางโทเคน จากนั้นทักบอท แล้วกด "ใช้แชทนี้" ในหน้าตั้งค่า
TELEGRAM_BOT_TOKEN=

# ---------- 5) LINE Official Account (ไม่บังคับ) ----------
# Channel access token (long-lived) จาก LINE Developers → Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=broadcast

# ---------- 6) Webhook เมื่อมีแจ้งเตือน (ไม่บังคับ) — Make.com / n8n / Home Assistant ----------
WEBHOOK_URL=

# ---------- 7) ไซเรน (ไม่บังคับ) ----------
# ไซเรน Zigbee ผ่าน zigbee2mqtt   ตัวอย่าง: mqtt://ชื่อผู้ใช้:รหัส@192.168.1.5:1883
MQTT_URL=
# MQTT_TOPIC=zigbee2mqtt/Siren/set
# SIREN_ENABLED=true

# ไซเรน/ปลั๊กที่สั่งผ่านลิงก์ (Home Assistant, Shelly, Tasmota …)
SIREN_WEBHOOK_ON_URL=
SIREN_WEBHOOK_OFF_URL=
# SIREN_WEBHOOK_METHOD=POST

# ---------- อื่นๆ ----------
# พอร์ตของหน้าเว็บ
# PORT=8080
# ลิงก์เปิดแดชบอร์ด แนบท้ายข้อความเตือน เช่น http://192.168.1.20:8080
# PUBLIC_URL=
# ชื่อบ้าน (ขึ้นในข้อความเตือน) และพิกัดระดับย่าน ใช้ดูฝนจาก Open-Meteo (ตั้งในหน้าเว็บก็ได้)
# SITE_NAME=บ้านของเรา
# LATITUDE=13.7563
# LONGITUDE=100.5018
# NEWS_QUERY=น้ำท่วม กรุงเทพ
# เปิดดูจากนอกบ้านผ่าน Cloudflare Tunnel + Access: ใส่ 2 ค่านี้แล้วน้องฝนจะรับการล็อกอินของ Access แทนรหัสผ่าน
# CF_ACCESS_TEAM_DOMAIN=ชื่อทีม.cloudflareaccess.com
# CF_ACCESS_AUD=

# ---------- ปลุกผ่าน iPhone (ไม่บังคับ) ----------
# แอป Pushover: ดังซ้ำทุก 30 วินาทีแม้ iPhone ปิดเสียงอยู่ (เปิด Override Silent Mode ในแอป) จนกว่าจะแตะรับทราบ
# PUSHOVER_TOKEN = API Token ของแอปที่สร้างใน pushover.net · PUSHOVER_USER = User Key (หรือ Group Key ของทั้งบ้าน)
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
